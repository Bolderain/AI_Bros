{
 "lang": "de",
 "voice": "de-DE-SeraphinaMultilingualNeural",
 "title": "Wie das Schachbrett sich selbst spielt",
 "bpm": 112,
 "speechEnd": 57.7,
 "total": 59.5,
 "lines": [
  {
   "i": 0,
   "beat": "hook",
   "text": "Ein Schachbrett, das seine Figuren selbst bewegt.",
   "start": 0,
   "dur": 3.322,
   "end": 3.322
  },
  {
   "i": 1,
   "beat": "brain",
   "text": "Oben spielst du.",
   "start": 3.772,
   "dur": 1.242,
   "end": 5.014
  },
  {
   "i": 2,
   "beat": "brain",
   "text": "Unten denkt ein Computer.",
   "start": 5.174,
   "dur": 1.847,
   "end": 7.021
  },
  {
   "i": 3,
   "beat": "brain",
   "text": "Millionen Züge, bevor er einen wählt.",
   "start": 7.181,
   "dur": 2.932,
   "end": 10.113
  },
  {
   "i": 4,
   "beat": "hand",
   "text": "Seine Hand ist ein Elektromagnet.",
   "start": 10.513,
   "dur": 2.512,
   "end": 13.025
  },
  {
   "i": 5,
   "beat": "hand",
   "text": "Er hängt unter dem Brett, an einem Riemen und zwei Motoren.",
   "start": 13.185,
   "dur": 3.822,
   "end": 17.007
  },
  {
   "i": 6,
   "beat": "problem",
   "text": "Aber Figuren können nicht übereinander hinweg.",
   "start": 17.457,
   "dur": 3.027,
   "end": 20.484
  },
  {
   "i": 7,
   "beat": "lines",
   "text": "Also fährt der Magnet nie über die Felder.",
   "start": 20.984,
   "dur": 2.647,
   "end": 23.631
  },
  {
   "i": 8,
   "beat": "lines",
   "text": "Sondern genau auf den Linien dazwischen.",
   "start": 23.791,
   "dur": 2.657,
   "end": 26.448
  },
  {
   "i": 9,
   "beat": "lines",
   "text": "Ein halbes Feld Abstand, links und rechts.",
   "start": 26.648,
   "dur": 3.237,
   "end": 29.885
  },
  {
   "i": 10,
   "beat": "slim",
   "text": "Deshalb ist jede Figur schlanker als ein halbes Feld.",
   "start": 30.285,
   "dur": 3.507,
   "end": 33.792
  },
  {
   "i": 11,
   "beat": "slim",
   "text": "Wer zu dick ist, bleibt stecken.",
   "start": 33.992,
   "dur": 2.382,
   "end": 36.374
  },
  {
   "i": 12,
   "beat": "capture",
   "text": "Beim Schlagen bringt er die Figur erst an den Rand.",
   "start": 36.824,
   "dur": 2.987,
   "end": 39.811
  },
  {
   "i": 13,
   "beat": "capture",
   "text": "Zwei Fahrten für einen Zug.",
   "start": 39.971,
   "dur": 2.017,
   "end": 41.988
  },
  {
   "i": 14,
   "beat": "release",
   "text": "Am Ziel muss er loslassen.",
   "start": 42.388,
   "dur": 1.857,
   "end": 44.245
  },
  {
   "i": 15,
   "beat": "release",
   "text": "Ein Schalter genügt: Strom aus.",
   "start": 44.405,
   "dur": 2.702,
   "end": 47.107
  },
  {
   "i": 16,
   "beat": "release",
   "text": "Das Feld ist weg, die Figur steht.",
   "start": 47.307,
   "dur": 2.687,
   "end": 49.994
  },
  {
   "i": 17,
   "beat": "sense",
   "text": "Deinen Zug fühlt das Brett selbst.",
   "start": 50.444,
   "dur": 2.307,
   "end": 52.751
  },
  {
   "i": 18,
   "beat": "sense",
   "text": "Vierundsechzig Sensoren, einer pro Feld.",
   "start": 52.951,
   "dur": 3.147,
   "end": 56.098
  },
  {
   "i": 19,
   "beat": "outro",
   "text": "Du bist dran.",
   "start": 56.598,
   "dur": 1.102,
   "end": 57.7
  }
 ],
