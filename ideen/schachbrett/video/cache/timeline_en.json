{
 "lang": "en",
 "voice": "en-US-AvaMultilingualNeural",
 "title": "How the Chessboard Plays Itself",
 "bpm": 112,
 "speechEnd": 51.26,
 "total": 53.06,
 "lines": [
  {
   "i": 0,
   "beat": "hook",
   "text": "A chessboard that moves its own pieces.",
   "start": 0,
   "dur": 2.477,
   "end": 2.477
  },
  {
   "i": 1,
   "beat": "brain",
   "text": "You play on top.",
   "start": 2.927,
   "dur": 1.102,
   "end": 4.029
  },
  {
   "i": 2,
   "beat": "brain",
   "text": "Underneath, a computer thinks.",
   "start": 4.189,
   "dur": 1.737,
   "end": 5.926
  },
  {
   "i": 3,
   "beat": "brain",
   "text": "Millions of moves, before it picks one.",
   "start": 6.086,
   "dur": 2.417,
   "end": 8.503
  },
  {
   "i": 4,
   "beat": "hand",
   "text": "Its hand is an electromagnet.",
   "start": 8.903,
   "dur": 2.112,
   "end": 11.015
  },
  {
   "i": 5,
   "beat": "hand",
   "text": "It hangs under the board, on one belt and two motors.",
   "start": 11.175,
   "dur": 3.262,
   "end": 14.437
  },
  {
   "i": 6,
   "beat": "problem",
   "text": "But pieces can't pass over each other.",
   "start": 14.887,
   "dur": 2.107,
   "end": 16.994
  },
  {
   "i": 7,
   "beat": "lines",
   "text": "So the magnet never crosses the squares.",
   "start": 17.494,
   "dur": 2.512,
   "end": 20.006
  },
  {
   "i": 8,
   "beat": "lines",
   "text": "It runs exactly on the lines between them.",
   "start": 20.166,
   "dur": 2.537,
   "end": 22.703
  },
  {
   "i": 9,
   "beat": "lines",
   "text": "Half a square of clearance, left and right.",
   "start": 22.903,
   "dur": 2.467,
   "end": 25.37
  },
  {
   "i": 10,
   "beat": "slim",
   "text": "Which is why every piece is slimmer than half a square.",
   "start": 25.77,
   "dur": 3.192,
   "end": 28.962
  },
  {
   "i": 11,
   "beat": "slim",
   "text": "Too fat, and it gets stuck.",
   "start": 29.162,
   "dur": 1.817,
   "end": 30.979
  },
  {
   "i": 12,
   "beat": "capture",
   "text": "On a capture, it walks the piece off the board first.",
   "start": 31.429,
   "dur": 3.152,
   "end": 34.581
  },
  {
   "i": 13,
   "beat": "capture",
   "text": "Two trips for one move.",
   "start": 34.741,
   "dur": 1.682,
   "end": 36.423
  },
  {
   "i": 14,
   "beat": "release",
   "text": "At the destination it has to let go.",
   "start": 36.823,
   "dur": 2.102,
   "end": 38.925
  },
  {
   "i": 15,
   "beat": "release",
   "text": "All it takes is a switch: current off.",
   "start": 39.085,
   "dur": 2.582,
   "end": 41.667
  },
  {
   "i": 16,
   "beat": "release",
   "text": "The field vanishes, the piece stays.",
   "start": 41.867,
   "dur": 2.312,
   "end": 44.179
  },
  {
   "i": 17,
   "beat": "sense",
   "text": "Your move, the board feels for itself.",
   "start": 44.629,
   "dur": 2.722,
   "end": 47.351
  },
  {
   "i": 18,
   "beat": "sense",
   "text": "Sixty-four sensors, one per square.",
   "start": 47.551,
   "dur": 2.422,
   "end": 49.973
  },
  {
   "i": 19,
   "beat": "outro",
   "text": "Your turn.",
   "start": 50.473,
   "dur": 0.787,
   "end": 51.26
  }
 ],
